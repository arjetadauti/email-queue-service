# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Either set DATABASE_URL (takes priority; used by Render/Railway/Neon)...
# DATABASE_URL=postgres://user:password@host:5432/email_queue
# ...or the individual PG* variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=email_queue
# Set to true for managed databases that require TLS
PGSSL=false
PG_CONNECT_TIMEOUT_MS=3000

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=re_your_api_key_here
# Must be a domain verified in Resend. onboarding@resend.dev works for testing
# but can only deliver to your own Resend account email.
EMAIL_FROM=Email Queue <onboarding@resend.dev>

# --- Worker / queue ---
# true  = worker runs inside the web process (one service, free hosting friendly)
# false = run `npm run worker` as a separate process
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_LOCK_TIMEOUT_MS=60000
# Retries after the first attempt (minimum required: 3)
EMAIL_MAX_RETRIES=3
# Backoff: base, 2x, 4x ... (5s, 10s, 20s with the default)
EMAIL_RETRY_BASE_DELAY_MS=5000
# Optional: Asniher heartbeat monitor URL, pinged while the worker is healthy
WORKER_HEARTBEAT_URL=
